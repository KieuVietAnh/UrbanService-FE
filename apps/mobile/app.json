{
  "expo": {
    "name": "UrbanMind",
    "slug": "urbanmind-mobile",
    "version": "1.0.0",
    "scheme": "urbanmind",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
     "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.giaunh.urbanmind",
      "supportsTablet": true
    },
    "android": {
      "package": "com.giaunh.urbanmind",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {},
    "plugins": [
      "./plugins/withGoogleMapsAndroidManifest.js",
      "expo-router"
    ],
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://api.urbanservice.me",
      
      "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "353963599123-7vtdpcp0okkrhrr2va9q4p4lbsndl6si.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "353963599123-ofbl3aoivkest6llsjh68qqrimp8p6eg.apps.googleusercontent.com",
      "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}",
      "router": {},
      "eas": {
        "projectId": "34fad211-1fae-4e82-ac99-11700199868e"
      }
    }
  }
}
